# Bot 不持有任何 provider 密钥。模型调用走 Gateway。
# 复制成 .env，它已在 .gitignore 里。
#
GATEWAY_URL=http://127.0.0.1:3080
# 用户 JWT（或日后的 bot-instance token）。没有它就拉不到目录、也调不了 /v1/*。
GATEWAY_TOKEN=
# Gateway 拉全文、实例报索引用的机器凭证，与 Gateway 的 GATEWAY_MACHINE_TOKEN 同一把。
GATEWAY_MACHINE_TOKEN=

# 文件/命令工具的工作区根目录。部署时由管家注入 /home/{linuxUser}/work；
# 本地不设就用 $SATUWORK_HOME/work。
# SATUWORK_WORK_DIR=

# 单个附件的上限（字节）。默认 100 MiB。上传是流式的，不进内存，也不进模型上下文。
# SATUWORK_UPLOAD_MAX=
