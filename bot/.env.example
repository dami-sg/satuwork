# Bot 不持有任何 provider 密钥。模型调用走 Gateway。
# 复制成 .env，它已在 .gitignore 里。
#
GATEWAY_URL=http://127.0.0.1:3080
# 席位 access token（sat_）。拉目录、上报 ready/索引，以及验证 Gateway 反代进来的 /api/*。
GATEWAY_TOKEN=
# 席位 API Key（sk_sw_）。只用于调用 Gateway 的 /v1/*，用量记在该账号。
GATEWAY_API_KEY=

# Bot 永远不持有机器票 smt_。那把票等同于整台机器的控制权，只留在机器管家的
# /etc/satuwork/manager.json 和 Gateway 的 machines.token 中。

# 文件/命令工具的工作区根目录。部署时由管家注入 /home/{linuxUser}/work；
# 本地不设就用 $SATUWORK_HOME/work。
# SATUWORK_WORK_DIR=

# 单个附件的上限（字节）。默认 100 MiB。上传是流式的，不进内存，也不进模型上下文。
# SATUWORK_UPLOAD_MAX=

# 报给模型的时区：历史消息上的 [时间] 按它渲染。
# 不设就用机器时区（管家会把机器时区设成公司选的那个），所以一般不需要设——
# 只有「席位跟用户不在同一个时区」时才用得上。IANA 名，如 Asia/Shanghai。
# SATUWORK_TZ=
