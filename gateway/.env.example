# Gateway 进程环境。复制成 .env（已在 .gitignore）。
#
# 平台级模型密钥只放在 Gateway。公司密钥走 /orgs/:id/credentials。
# 不要把这些写到 bot 的磁盘或环境。
#
# GATEWAY_HOST=127.0.0.1
# GATEWAY_PORT=3080
# GATEWAY_MACHINE_TOKEN=
# GATEWAY_PLATFORM_TOKEN=
# GATEWAY_ACCESS_HOST=satuwork.com
#
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com
# ANTHROPIC_BASE_URL=https://api.anthropic.com
