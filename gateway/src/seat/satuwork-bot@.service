[Unit]
Description=Satuwork bot for %i
After=network.target slim-desktop@%i.service

[Service]
Type=simple
User=%i
Group=%i
WorkingDirectory=/home/%i/satuwork-bot
Environment=HOME=/home/%i
Environment=XDG_SESSION_TYPE=x11
Environment=GDK_BACKEND=x11
EnvironmentFile=-/home/%i/.satuwork/bot.env
UnsetEnvironment=WAYLAND_DISPLAY DEEPSEEK_API_KEY OPENAI_API_KEY ANTHROPIC_API_KEY
ExecStart=/usr/bin/node --import tsx /home/%i/satuwork-bot/bin/satuwork.mjs
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
